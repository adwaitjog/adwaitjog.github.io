---
layout: null
permalink: /site.webmanifest
sitemap: false
---
{
  "name": "{{ site.author.name }}",
  "short_name": "Adwait Jog",
  "icons": [
    { "src": "{{ '/assets/img/icon-192.png' | relative_url }}", "sizes": "192x192", "type": "image/png" },
    { "src": "{{ '/assets/img/icon-512.png' | relative_url }}", "sizes": "512x512", "type": "image/png" }
  ],
  "theme_color": "#232d4b",
  "background_color": "#ffffff",
  "display": "browser",
  "start_url": "/"
}
