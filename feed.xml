---
layout: null
permalink: /feed.xml
sitemap: false
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.author.name }} · News</title>
  <subtitle>News from {{ site.author.name }} and the Insight Computer Architecture Lab</subtitle>
  <link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/atom+xml"/>
  <link href="{{ '/news.html' | absolute_url }}" rel="alternate" type="text/html"/>
  <id>{{ '/feed.xml' | absolute_url }}</id>
  <updated>{{ site.data.news[0].date | date_to_xmlschema }}</updated>
  <author><name>{{ site.author.name }}</name></author>
  {%- for item in site.data.news limit: 30 %}
  {%- assign plain = item.text | strip_html | normalize_whitespace %}
  <entry>
    <title>{{ plain | truncatewords: 14 | xml_escape }}</title>
    <link href="{{ '/news.html' | absolute_url }}" rel="alternate" type="text/html"/>
    <id>{{ '/news.html' | absolute_url }}#{{ item.date | date: '%Y-%m' }}-{{ forloop.index }}-{{ plain | slugify | truncate: 40, '' }}</id>
    <updated>{{ item.date | date_to_xmlschema }}</updated>
    <content type="html">{{ item.text | replace: 'href="/', 'href="https://adwaitjog.github.io/' | xml_escape }}</content>
  </entry>
  {%- endfor %}
</feed>
